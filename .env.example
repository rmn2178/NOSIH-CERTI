# ═══════════════════════════════════════════════════════════════
# NOSIH — copy this file to .env in the repository root and fill it in.
#
# This is the only backend environment file. The backend resolves it from
# its own module location (backend/env.js), so it is read no matter which
# directory you start the process from. The frontend keeps its own
# frontend/.env.local for REACT_APP_* values, which are inlined into the
# production bundle at BUILD time (they are public — never put secrets there).
#
# On Vercel there is no .env file — the platform injects the variables
# instead. Use `npm run vercel:env` to push this file to the project.
#
# Never commit .env.
# ═══════════════════════════════════════════════════════════════

# ── Blockchain (Polygon Amoy, chain 80002) ─────────────────
# ALCHEMY_AMOY_URL is checked first — set it when you have an Alchemy key.
# Until then AMOY_RPC_URL is used.
ALCHEMY_AMOY_URL=
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# CertificateRegistry deployment address — filled by `npm run deploy:amoy`.
# Verification is chain-authoritative: without it every verify answers 503.
CONTRACT_ADDRESS=

# Informational only — hardhat.config.js pins Amoy=80002, Polygon=137
CHAIN_ID=80002

# ── Chain keys (server-side) ───────────────────────────────
# Deployer wallet — pays gas for the deploy and holds DEFAULT_ADMIN_ROLE:
# the only account that can authorize/remove issuers (npm run issuer:add /
# issuer:remove). MUST hold POL on Amoy.
DEPLOYER_PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY_WITHOUT_0x

# Dedicated revocation wallet — the ONLY server-side chain write.
# `npm run deploy:amoy` grants it REVOKER_ROLE. It needs a little POL for gas.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVOKE_PRIVATE_KEY=YOUR_REVOKER_PRIVATE_KEY_WITHOUT_0x

# Reference only — the issuer wallet that signs issuance IN METAMASK.
# There is NO issuer private key on the server: issueCertificate is signed
# only by the issuer's own browser wallet. Import the issuer key into
# MetaMask, fund it with POL, then authorize it: npm run issuer:add
ISSUER_ADDRESS=0xYourIssuerWalletAddress

# Optional — for contract source verification on polygonscan
POLYGONSCAN_API_KEY=

# ── Certificate secrets ────────────────────────────────────
# 64 hex chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THESE UP. Losing DOCUMENT_ENC_KEY makes every stored certificate
# unreadable; changing HASH_PEPPER changes every identity hash so new
# certificates stop linking to old ones.
DOCUMENT_ENC_KEY=
HASH_PEPPER=

# ── Database (Supabase) ────────────────────────────────────
# 1. Create a project at https://supabase.com
# 2. Apply the schema — either paste backend/supabase/schema.sql (fresh
#    project) or migrations/001_nosih.sql (existing NOSIH database, additive)
#    into the SQL editor, or run `npm run schema:apply` / `npm run
#    schema:migrate` with SUPABASE_DB_PASSWORD set below. The script also
#    grants service_role privileges and reloads the PostgREST schema cache.
# 3. Copy the URL and the service_role SECRET key from Project Settings → API.
#    The publishable (sb_publishable_…) key CANNOT read the users table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Optional — only for schema:apply / schema:migrate (direct Postgres DDL;
# PostgREST cannot run CREATE TABLE). Project Settings → Database password.
SUPABASE_DB_PASSWORD=

# ── IPFS (Pinata) ──────────────────────────────────────────
# Either a JWT, or API key + secret. The backend prefers the JWT whenever
# one is set, so only enable a token that `npm run check:jwt` accepts.
# Only AES-256-GCM ciphertext is ever pinned — never plaintext documents.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=8h

# ── App (local only — not deployed to Vercel) ──────────────
PORT=5000
NODE_ENV=development
BACKEND_PUBLIC_URL=http://localhost:5000
VERIFY_BASE_URL=http://localhost:3000/verify
FRONTEND_URL=http://localhost:3000
IPFS_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs

# Upload cap in MB. Defaults to 15 locally and 4 on Vercel (4.5 MB body limit).
# Only set this to override.
# MAX_UPLOAD_MB=15

# ── AI (Google Gemini) ─────────────────────────────────────
# Text-only extraction: the model receives extracted TEXT, never the file.
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Extraction tuning (all optional — the defaults are the tested ones) ──
# EXTRACTION_BUDGET_MS=120000
# GEMINI_TIMEOUT_MS=45000
# GEMINI_MAX_ATTEMPTS=3
# GEMINI_BACKOFF_MS=750
# GEMINI_BASE_URL=

# ── Local OCR (Tesseract) ──────────────────────────────────
# Scanned pages are recognised ON THE SERVER; only the text dump is sent to
# the model, so no certificate image leaves the deployment.
# OCR_LANG=eng
# OCR_TIMEOUT_MS=60000
# TESSERACT_CACHE_PATH=
# TESSERACT_LANG_PATH=

# ── Platform-admin bootstrap (npm --prefix backend run seed:admin) ──
# Creates/repairs the platform_admin account that approves institutions.
ADMIN_EMAIL=admin@nosih.example
ADMIN_PASSWORD=ChangeThisPassword123!

# ═══════════════════════════════════════════════════════════════
# FRONTEND — frontend/.env.local (BUILD-time, PUBLIC values only)
# ═══════════════════════════════════════════════════════════════
# REACT_APP_API_URL=/api
# REACT_APP_CONTRACT_ADDRESS=0xYourCertificateRegistryAddress
# REACT_APP_CHAIN_ID=80002
# REACT_APP_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
#
# On Vercel these must exist as project env vars BEFORE the build —
# `npm run vercel:env` pushes them from frontend/.env.local.